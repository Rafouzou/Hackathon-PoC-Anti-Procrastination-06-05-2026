rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User documents
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
      
      // Tasks subcollection
      match /tasks/{taskId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Daily assignments - users can only read their own
    match /dailyAssignments/{assignmentDoc} {
      allow read: if request.auth.uid == resource.data.uid || 
                     request.auth.uid == resource.data.verifyingUserId;
      allow create, write: if request.auth == null; // Only server can write
      
      // Messages subcollection - both owner & verifier can read/create
      match /messages/{messageId} {
        allow read, create: if request.auth.uid == get(/databases/$(database)/documents/dailyAssignments/$(assignmentDoc)).data.uid ||
                               request.auth.uid == get(/databases/$(database)/documents/dailyAssignments/$(assignmentDoc)).data.verifyingUserId;
        allow update, delete: if false; // No updates/deletes allowed
      }
    }
  }
}
