rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User documents
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
      
      // Tasks subcollection
      match /tasks/{taskId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Daily assignments - users can only read their own
    match /dailyAssignments/{assignmentDoc} {
      allow read: if request.auth.uid == resource.data.uid || 
                     request.auth.uid == resource.data.verifyingUserId;
      allow write: if request.auth == null; // Only server can write
    }

    // Messages/Chat 
    match /messages/{messageId} {
      allow read, write: if request.auth.uid == resource.data.senderId ||
                            request.auth.uid == resource.data.receiverId;
    }
  }
}
